    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@uiw/react-codemirror": "4.25.12",
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "gray-matter": "4.0.3",
    "next": "16.3.7",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-stringify": "10.0.1",
