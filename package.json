{
  "name": "javascript-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/copy-ts-runtime.mjs && node scripts/build-sandbox.mjs",
